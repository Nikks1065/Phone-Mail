# PhoneMail Environment Configuration

PORT=3000
NODE_ENV=development

# Demo OTP codes in API responses (not related to demo user accounts)
DEMO_MODE=false

# Optional demo seed accounts — leave false for real username/password usage
SEED_DEMO_DATA=false

# Database
# Prefer PostgreSQL in Docker / production:
# DATABASE_URL=postgres://phonemail:phonemail_secret@postgres:5432/phonemail_db
# When unset, PhoneMail uses embedded PGlite (Postgres-compatible) at .data/pglite

JWT_SECRET=change_me_to_a_long_random_secret
ADMIN_SECRET=change_me_admin_tool_secret

EMAIL_DOMAIN=phonemail.com

SMS_PROVIDER=simulated
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_SMS_TEMPLATE=

APP_URL=http://localhost:3000
CORS_ORIGIN=
