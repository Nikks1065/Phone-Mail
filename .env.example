# PhoneMail Environment Configuration

# Server & Port
PORT=3000
NODE_ENV=development

# Demo mode returns OTP in API responses for local evaluation only.
# Set to false (and NODE_ENV=production) for real deployments.
DEMO_MODE=true

# Database (PostgreSQL) — optional.
# When unset or unreachable, PhoneMail uses a persistent JSON store at .data/phonemail_db.json
# For Docker Compose Postgres:
DATABASE_URL=postgres://phonemail:phonemail_secret@postgres:5432/phonemail_db

# Authentication
JWT_SECRET=change_me_to_a_long_random_secret
ADMIN_SECRET=change_me_admin_tool_secret

# Email Domain
EMAIL_DOMAIN=phonemail.com

# SMS Provider Configuration
# Set to 'twilio' for real SMS, or 'simulated' for local demo
SMS_PROVIDER=simulated
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Optional template ({{sender}} and {{subject}} placeholders). Free-tier
# Twilio may require pre-approved templates instead of arbitrary text.
TWILIO_SMS_TEMPLATE=

# External URLs / CORS
APP_URL=http://localhost:3000
CORS_ORIGIN=
